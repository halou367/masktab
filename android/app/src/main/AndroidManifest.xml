<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 在线更新（决策 N-3）：从 GitHub 下载新版本后请系统安装；第一次用时系统会让用户确认“允许 MaskTab 安装应用” -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 下载文件（决策 A-14）：下载途中开一个前台服务，切到别的应用、锁屏时系统不会把 app 收走；通知栏里显示进度（安卓 13 起通知要用户同意，不同意也能下）。
         存文件不用存储权限：安卓 10 起经 MediaStore 放进系统的“下载”文件夹，安卓 8、9 放在 app 自己的外部目录 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- networkSecurityConfig：只放行本机 mihomo 控制接口与 ip-api.com 的明文 HTTP（见 res/xml/network_security_config.xml）
         extractNativeLibs：mihomo 以 libmihomo.so 放在 jniLibs，必须解压到 nativeLibraryDir 才能执行 -->
    <application
        android:label="MaskTab"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaskTab">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>
        <!-- 系统安装更新时的进展通知（Updater.kt），只收本应用自己发的 -->
        <receiver android:name=".UpdateReceiver" android:exported="false" />
        <!-- 下载途中的前台服务（Downloads.kt） -->
        <service android:name=".DownloadService" android:exported="false" android:foregroundServiceType="dataSync" />
        <!-- 把下载好的文件交给别的应用打开 / 分享（只有安卓 8、9 用得到：那上面文件存在 app 自己的目录里；安卓 10 起用系统下载文件夹自己的地址） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
