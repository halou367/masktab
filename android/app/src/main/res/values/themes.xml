<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 照安卓 Chrome 的深色样子（决策 UI-1）；浅色主题由代码按设置“外观”切换外壳的颜色。
         状态栏、导航栏透明：内容全屏绘制，两条栏的底色由 BarsLayout 按当前页面涂（决策 UI-4）。 -->
    <style name="Theme.MaskTab" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">#bdc5ea</item>
        <item name="android:colorAccent">#bdc5ea</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/mt_bg</item>
    </style>
</resources>
