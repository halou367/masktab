{
  "manifest_version": 3,
  "name": "MaskTab",
  "version": "0.1.0",
  "description": "MaskTab 伴随扩展：节点面板、实例管理、新标签页。",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MaskTab"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "commands": {
    "new-instance": {
      "suggested_key": {
        "default": "Ctrl+M",
        "mac": "Command+M"
      },
      "description": "新建伪装实例"
    },
    "open-manager": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "实例管理"
    },
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "打开节点面板"
    }
  }
}
