{
  "manifest_version": 3,
  "name": "MaskTab 默认搜索",
  "version": "0.1.0",
  "description": "把地址栏默认搜索设为 Bing（仅 Windows / macOS 生效；单独成一个扩展，失败不影响伴随扩展）。",
  "key": "",
  "chrome_settings_overrides": {
    "search_provider": {
      "name": "Bing",
      "keyword": "bing.com",
      "search_url": "https://www.bing.com/search?q={searchTerms}",
      "favicon_url": "https://www.bing.com/favicon.ico",
      "suggest_url": "https://www.bing.com/osjson.aspx?query={searchTerms}",
      "encoding": "UTF-8",
      "is_default": true
    }
  }
}
